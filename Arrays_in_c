#include <stdio.h>

int main() {
    int x[] = {0, 1, 1, 13, 14, 18, 20};
    int y[] = {1, 2, 3, 10, 100, 14, 2};
    int len = 7;
    double sum = 0;

    for (int i = 0; i < len - 1; i++) {
        double dx = x[i + 1] - x[i];
        double dy = y[i + 1] - y[i];
        sum += dx + dy;
    }

    printf("Sum: %f\n", sum);
    return 0;
}
